DATABASE_URL="postgresql://postgres:password@localhost:5432/habit_tracker?schema=public"
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_USER="postgres"
DATABASE_PASSWORD="example_password"
JWT_SECRET="mM7/QRn2nFE74JfPtFw2Cg2WJ8xOwhGmOs+w7iU6EzE="
JWT_EXPIRES_IN="5D"
# Distinct from JWT_SECRET on purpose: keeps a password-reset token from being
# accepted as an access token by JwtStrategy.
JWT_RESET_SECRET="generate-with-openssl-rand-base64-32"

# SMTP — Mailtrap sandbox in development, any SMTP host in production
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_SECURE="false"
SMTP_USER="your_mailtrap_user"
SMTP_PASS="your_mailtrap_pass"
MAIL_FROM="Bloom <no-reply@bloom.app>"