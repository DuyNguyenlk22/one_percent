# Copy to .env and fill in. Never commit the real file.

# Postgres connection string used by Prisma and the pg adapter.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/habit

# Signing key for access tokens. Use a long random string in any shared environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=5d

# Port the API listens on. Defaults to 3000 when unset.
PORT=3000
